# OpenAI Platform (https://platform.openai.com/api-keys) 에서 API Key 를 발급받아 아래에 붙여넣기 하세요.
OPENAI_API_KEY=<Your OpenAI API Key>

# (선택) 사용할 모델. 생략하면 기본 모델(gpt-5.6-luna)을 씁니다.
# AI_MODEL=gpt-5.6-sol

# (선택) OpenAI 대시보드(Traces)로 에이전트 실행 기록을 보내지 않으려면 1
# OPENAI_AGENTS_DISABLE_TRACING=1

# (선택) AI 기능 전체 끄기
# AI_ENABLED=false
